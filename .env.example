# ==============================================================================
# HIRESHIELD ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and fill in real values before running the project.
# NEVER commit .env to version control.
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your actual keys
#   docker compose up --build

# ------------------------------------------------------------------------------
# BACKEND (FASTAPI)
# ------------------------------------------------------------------------------
ENVIRONMENT=development
API_V1_STR=/api/v1
PROJECT_NAME=HireShield

# ------------------------------------------------------------------------------
# DATABASE (PostgreSQL + pgvector)
# ------------------------------------------------------------------------------
POSTGRES_SERVER=db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=hireshield

# Full async connection string used by SQLAlchemy
DATABASE_URI=postgresql+asyncpg://postgres:postgres@db:5432/hireshield

# ------------------------------------------------------------------------------
# CLERK (AUTHENTICATION)
# Get these from https://dashboard.clerk.com → API Keys
# ------------------------------------------------------------------------------

# Backend — used to verify JWT tokens from the frontend
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
CLERK_JWKS_URL=https://<your-clerk-domain>.clerk.accounts.dev/.well-known/jwks.json

# CORS — comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------------------
# AI PROVIDER (GOOGLE GEMINI)
# Get your key at https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key

# ------------------------------------------------------------------------------
# FRONTEND (NEXT.JS)
# ------------------------------------------------------------------------------

# Exposed to the browser (must be prefixed NEXT_PUBLIC_)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# URL the browser uses to reach the API (public-facing)
NEXT_PUBLIC_API_URL=http://localhost:8000

# URL Next.js SSR uses to reach the API from inside Docker network
# When running locally (no Docker), set this to http://localhost:8000
INTERNAL_API_URL=http://backend:8000

# ------------------------------------------------------------------------------
# FILE UPLOAD LIMITS
# ------------------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=10
MAX_PDF_PAGES=20
